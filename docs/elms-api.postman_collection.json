{
  "info": {
    "name": "ELMS API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "authToken", "value": "" },
    { "key": "managerToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Employee",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@joyfulbot.com\",\n  \"password\": \"Test@123\",\n  \"departmentId\": 1\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Register successful', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.success).to.be.true; });"] }
          }]
        },
        {
          "name": "Login Employee",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"soham.naik@joyfulbot.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Login successful', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.success).to.be.true; pm.collectionVariables.set('authToken', json.data.token); });"] }
          }]
        },
        {
          "name": "Login Manager",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"raj.mehta@joyfulbot.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Manager login successful', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.data.role).to.equal('MANAGER'); pm.collectionVariables.set('managerToken', json.data.token); });"] }
          }]
        }
      ]
    },
    {
      "name": "Employee - Leaves",
      "item": [
        {
          "name": "Apply Leave",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/leaves",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveTypeId\": 1,\n  \"startDate\": \"2025-12-01\",\n  \"endDate\": \"2025-12-02\",\n  \"reason\": \"Personal work at home\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Leave applied successfully', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.success).to.be.true; pm.expect(json.data.status).to.equal('PENDING'); });"] }
          }]
        },
        {
          "name": "Get My Leaves",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/leaves?page=0&size=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Leaves fetched', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.success).to.be.true; });"] }
          }]
        },
        {
          "name": "Get Leave Balance",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/leaves/balance",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Balance fetched', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.success).to.be.true; pm.expect(json.data).to.be.an('array'); });"] }
          }]
        },
        {
          "name": "Cancel Leave",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/leaves/5",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Leave cancelled', function() { pm.response.to.have.status(200); });"] }
          }]
        }
      ]
    },
    {
      "name": "Manager",
      "item": [
        {
          "name": "Get Team Leaves",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manager/team-leaves?status=PENDING",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Team leaves fetched', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.success).to.be.true; });"] }
          }]
        },
        {
          "name": "Approve Leave",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/leaves/5/approve",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Approved. Enjoy your leave.\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Leave approved', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.data.status).to.equal('APPROVED'); });"] }
          }]
        },
        {
          "name": "Reject Leave",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/leaves/6/reject",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Rejected due to project deadline.\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Leave rejected', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.data.status).to.equal('REJECTED'); });"] }
          }]
        },
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manager/analytics",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Analytics fetched', function() { pm.response.to.have.status(200); var json = pm.response.json(); pm.expect(json.data).to.have.property('pending'); pm.expect(json.data).to.have.property('approved'); pm.expect(json.data).to.have.property('rejected'); });"] }
          }]
        }
      ]
    },
    {
      "name": "Security Tests",
      "item": [
        {
          "name": "No Token - Should Return 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/leaves"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Returns 401 without token', function() { pm.response.to.have.status(401); });"] }
          }]
        },
        {
          "name": "Employee Token on Manager Route - Should Return 403",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manager/team-leaves",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Returns 403 for wrong role', function() { pm.response.to.have.status(403); });"] }
          }]
        }
      ]
    }
  ]
}
